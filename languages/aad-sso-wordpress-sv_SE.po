msgstr "FEL: Oväntat svar vid kontroll av gruppmedlemskap med Microsoft Graph."

#: aad-sso-wordpress.php:363
#, php-format
msgid "ERROR: Could not get an access token to Microsoft Graph. %s"
msgstr "FEL: Kunde inte hämta en åtkomsttoken till Microsoft Graph. %s"

#: aad-sso-wordpress.php:370
