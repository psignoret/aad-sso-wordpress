#, php-format
msgid "ERROR: Error creating user '%s'."
msgstr "FEL: Fel vid skapande av användare '%s'."

#: aad-sso-wordpress.php:474
#, php-format
msgid ""
"ERROR: The authenticated user '%s' is not a registered user in this site."
msgstr ""
"FEL: Den autentiserade användaren '%s' är inte en registrerad användare på "
"denna webbplats."

#: aad-sso-wordpress.php:519
#, php-format
msgid ""
"ERROR: Microsoft Entra ID user %s is not a member of any group granting a "
"role."
msgstr ""
"FEL: Microsoft Entra ID-användare %s är inte medlem i någon grupp som "
"tilldelar en roll."

#: aad-sso-wordpress.php:624
msgid ""
"Single Sign-on with Microsoft Entra ID required settings are not defined. "
"Update them under Settings > Microsoft Entra ID."
msgstr ""
"Obligatoriska inställningar för Single Sign-On med Microsoft Entra ID är "
"inte definierade. Uppdatera dem under Inställningar > Microsoft Entra ID."

#: aad-sso-wordpress.php:652
#, php-format
msgid "Sign in with your %s account"
msgstr "Logga in med ditt %s-konto"

#: aad-sso-wordpress.php:655
msgid "Sign out"
msgstr "Logga ut"

#. Plugin Name of the plugin/theme
#: view/settings.php:3
